# WAMSS environment. Copy to .env and fill in values:
#   cp .env.example .env
# Never commit .env to git. All values here are placeholders.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# SQLite (default): file lives in the backend-data Docker volume, survives restarts.
DATABASE_URL=sqlite:////app/data/wamss.db

# PostgreSQL (use with `docker compose --profile postgres up --build`):
# DATABASE_URL=postgresql+psycopg://wamss:changeme@postgres:5432/wamss
# POSTGRES_USER=wamss
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=wamss

# Optional API key. When set, every backend request must send header X-API-Key.
# When empty, authentication stays disabled (development default).
WAMSS_API_KEY=

# Map employee IDs to SHA-256 hashes of their personal tokens (never raw tokens).
WAMSS_EMPLOYEE_TOKEN_HASHES={}
# Optional manager check-ins fail closed unless this protected server-side map is configured.
# Map SHA-256 hashes of manager tokens to exact administrator-authorized employee-ID rosters.
# Never store raw manager tokens here or in source control.
WAMSS_MANAGER_ROSTER_TOKEN_HASHES={}
# Disabled by default. Enable only for a trusted, server-side multi-employee
# ingestion service with a validated WAMSS_API_KEY; never expose that key to browsers.
WAMSS_EMPLOYEE_INGESTION_SERVICE_ACCESS=0

# Daily app categories are read from backend/app/app_categories.json.
# Unmapped applications are always neutral. Replace/edit the JSON map as needed.
WAMSS_APP_CATEGORY_FILE=/app/app/app_categories.json

# Daily attendance is explicitly opt-in and disabled by default. Enable only
# after employee notice and any required separate camera-identity consent.
WAMSS_ATTENDANCE_ENABLED=0
WAMSS_ATTENDANCE_MIN_CONFIDENCE=0.5
WAMSS_ATTENDANCE_DWELL_CAP_SEC=300
# Map recognized camera display names to workstation employee IDs when they differ.
WAMSS_ATTENDANCE_IDENTITY_MAP=/app/app/attendance_identity_map.json
# Only include identities with separately documented, affirmative camera consent.
WAMSS_ATTENDANCE_CAMERA_CONSENT_FILE=/app/app/attendance_camera_consents.json

# Camera identity is denied unless its mode is explicitly "identity" and
# each employee has active per-camera consent below. All missing, malformed,
# or unlisted camera modes are aggregate-only. Example for a single camera:
# WAMSS_CAMERA_PRIVACY_MODES='{"CAM_01":"identity"}'
WAMSS_CAMERA_PRIVACY_MODES=

# ---------------------------------------------------------------------------
# Frontend (baked into the dashboard at build time)
# ---------------------------------------------------------------------------
# The URL the *browser* uses to reach the backend.
VITE_API_URL=http://localhost:8000
