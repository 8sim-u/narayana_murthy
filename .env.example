# WAMSS environment. Copy to .env and fill in values:
#   cp .env.example .env
# Never commit .env to git. All values here are placeholders.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# SQLite (default): file lives in the backend-data Docker volume, survives restarts.
DATABASE_URL=sqlite:////app/data/wamss.db

# PostgreSQL (use with `docker compose --profile postgres up --build`):
# DATABASE_URL=postgresql+psycopg://wamss:changeme@postgres:5432/wamss
# POSTGRES_USER=wamss
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=wamss

# Optional API key. When set, every backend request must send header X-API-Key.
# When empty, authentication stays disabled (development default).
WAMSS_API_KEY=

# ---------------------------------------------------------------------------
# Frontend (baked into the dashboard at build time)
# ---------------------------------------------------------------------------
# The URL the *browser* uses to reach the backend.
VITE_API_URL=http://localhost:8000
