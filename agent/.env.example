# WAMSS workstation activity agent: example configuration.
# Copy to .env (or export in your shell / service definition) and edit.
# NEVER commit real machine or employee ids to the repo.

# Backend base URL the agent syncs activity batches to.
WAMSS_AGENT_SERVER_URL=http://localhost:8000

# Identity. Keep these out of version control.
WAMSS_MACHINE_ID=workstation-001
WAMSS_EMPLOYEE_ID=employee-001
# Windows installer writes the bound interactive account and protected-store
# path here. Never add WAMSS_EMPLOYEE_TOKEN or WAMSS_API_KEY to this file.
# WAMSS_INTERACTIVE_USER=domain\employee
# WAMSS_SECRET_DIR=C:\ProgramData\WAMSS\agent\secrets
# Office/site this workstation belongs to (sent as office_id on every
# activity record; backend filters dashboards by it). Default is "hq".
WAMSS_OFFICE_ID=hq

# Collection cadence: one activity segment per interval, in seconds.
WAMSS_LOG_INTERVAL=60
# Upload cadence: how often the agent tries to sync the spool, in seconds.
WAMSS_SYNC_INTERVAL=300
# Set to 0 when the optional Windows sync service owns uploads; the signed-in
# collector still records to its identity-scoped spool after consent.
WAMSS_SYNC_ENABLED=1
# No input for this many seconds marks the segment idle.
WAMSS_IDLE_AFTER_SEC=180
# Base directory for JSONL buffers used when the server is unreachable.
# The agent creates a separate hashed subdirectory per employee + OS user.
WAMSS_SPOOL_DIR=./spool
# Max records per POST /activity batch.
WAMSS_MAX_BATCH=500
# Upper bound for the exponential backoff between sync retries, in seconds.
WAMSS_MAX_BACKOFF_SEC=3600

# Screenshots are OFF by default and the agent never captures keystroke content.
# This flag is reserved; leave it 0.
WAMSS_SCREENSHOTS=0

# --- Strain (workload tension) heuristic ---------------------------------
# Continuous active minutes without a break before the strain signal saturates.
WAMSS_STRAIN_ACTIVE_MIN_THRESHOLD=90
# Keystrokes + clicks per minute considered a high-intensity burst.
WAMSS_STRAIN_INTENSITY_PER_MIN=120
# Window switches per 5 minutes considered excessive.
WAMSS_STRAIN_SWITCHES_PER_5MIN=10
# Work hours, local time, HH:MM-HH:MM. Activity outside counts toward strain.
WAMSS_WORK_HOURS=09:00-18:00
# Strain score (0-100) that triggers a break reminder.
WAMSS_BREAK_THRESHOLD=70
# Minutes a break reminder stays snoozed after it fires.
WAMSS_BREAK_SNOOZE_MIN=15
# Minimum minutes between two break reminders.
WAMSS_BREAK_REMINDER_COOLDOWN_MIN=60
# Idle minutes that reset the continuous-active-work clock.
WAMSS_BREAK_RESET_IDLE_MIN=5

# --- Backend strain alert rule (read by the backend process) -------------
# Strain score at/above which a batch counts toward the alert rule.
WAMSS_STRAIN_ALERT_THRESHOLD=70
# Consecutive over-threshold batches before HIGH_STRAIN_DETECTED is raised.
WAMSS_STRAIN_ALERT_BATCHES=3

# Dry-run helper: run the collector for N seconds and exit (for testing).
# WAMSS_DRY_RUN_SECONDS=45

# --- Privacy: exclusion list ----------------------------------------------
# Comma-separated process/app names that are NEVER logged (not even spooled).
# Matching is case-insensitive.
WAMSS_EXCLUDED_APPS=KeePass.exe,1Password.exe,bitwarden.exe,signal.exe
# Optional regex: any active window whose title matches is skipped.
# WAMSS_EXCLUDED_TITLES=(?i)\b(password|bank|otp)\b
# Consent marker is bound to WAMSS_EMPLOYEE_ID and the active OS user.
# Defaults: Windows %LOCALAPPDATA%\WAMSS\consent.json; Linux
# $XDG_STATE_HOME/wamss/consent.json (or ~/.local/state/wamss/consent.json).
# This exact-path override is shared by tray, full agent, sync, and withdrawal.
# WAMSS_CONSENT_FILE=C:\wamss\consent.json

# --- Optional private wellness wearable -----------------------------------
# Default off. Enabling BLE triggers a separate employee consent prompt.
# Requires the employee's own token above and server-side
# wellness consent on the personal dashboard; live samples are never spooled.
WAMSS_BLE_ENABLED=0
# Optional private local break toast based on the employee-only combined
# work-strain/personal-HRV prompt. Default off; requires employee token plus
# separate local and dashboard wellness consent. Only a suggestion is logged.
WAMSS_WELLNESS_BREAK_PROMPTS=0
# Device name substring or MAC address. Empty = first standard HR-service device.
WAMSS_BLE_DEVICE=
# Seconds between BLE reconnect attempts.
WAMSS_BLE_INTERVAL=60
# Separate, identity-bound local consent marker. Defaults: Windows
# %LOCALAPPDATA%\WAMSS\wellness-consent.json; Linux
# $XDG_STATE_HOME/wamss/wellness-consent.json (or ~/.local/state/wamss/...).
# Keep any exact-path override writable and private to the intended employee.
# WAMSS_WELLNESS_CONSENT_FILE=C:\path\to\wellness-consent.json
# Wearable values are private and are NOT blended into team strain or alerts.

# --- Security / DLP signals (read by agent/usb_monitor.py) -----------------
# File-write burst threshold in MB per interval (byte counts only, never content).
WAMSS_DLP_WRITE_THRESHOLD_MB=500
# Interval in seconds over which write bytes are counted.
WAMSS_DLP_WRITE_INTERVAL_SEC=300
