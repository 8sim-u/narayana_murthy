# WAMSS Work Monitor starter config.
# Copy this file to config.env beside WAMSSWorkMonitor.exe and fill in the
# real values. The build script copies your config.env beside the executable
# when one exists, otherwise it copies this starter as config.env.example.
# Never put the employee token or the deployment API key in this file: the
# monitor collects the employee token through a masked prompt on first run.
WAMSS_AGENT_SERVER_URL=https://wamss.example.invalid
WAMSS_IDLE_AFTER_SEC=300
WAMSS_LOG_INTERVAL=60
WAMSS_EMPLOYEE_ID=
WAMSS_MACHINE_ID=
WAMSS_OFFICE_ID=hq
