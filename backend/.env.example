APP_NAME=narayana-murthy-surveillance-api
ENVIRONMENT=development

# Local development default: SQLite. No database server required to boot the API.
# A file named wamss_dev.db is created next to the backend/ folder on first run.
DATABASE_URL=sqlite:///./wamss_dev.db

# Production / team deployment: PostgreSQL.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME

# Required for employee-scoped reads, employee-attributed writes, and wellness APIs. Map employee
# IDs to SHA-256 token hashes only; never store raw employee tokens here or in git.
WAMSS_EMPLOYEE_TOKEN_HASHES={}
# Optional manager check-ins fail closed unless this server-side map is configured.
# Map SHA-256 hashes of manager tokens to exact, administrator-authorized employee-ID rosters.
# Never store raw manager tokens here or in source control.
WAMSS_MANAGER_ROSTER_TOKEN_HASHES={}
# Disabled by default. Set to 1 only for a trusted service that must ingest
# multiple employee IDs using a deployment API key; never expose that key to browsers.
WAMSS_EMPLOYEE_INGESTION_SERVICE_ACCESS=0

# Identity camera processing is denied unless explicitly enabled per camera.
# Unlisted or invalid camera IDs are aggregate-only. Example:
# WAMSS_CAMERA_PRIVACY_MODES='{"CAM_01":"identity"}'
WAMSS_CAMERA_PRIVACY_MODES=

# For an identity camera, configure attendance_identity_map.json as
# {"Employee Display Name":"employee-001"} and
# attendance_camera_consents.json as
# {"employee-001":{"consented":true,"recorded_at":"2026-11-14T10:00:00Z","camera_ids":["CAM_01"]}}.
# Set consented=false (and optionally revoked_at) to withdraw prospectively.

# Wellness/activity retention and the calendar-day boundary used by the API.
WAMSS_RETENTION_DAYS=90
WAMSS_TIMEZONE=UTC

# WAMSS_API_KEY=<deployment-secret>
