# WAMSS vision pipeline environment configuration
# Copy this file to .env (do NOT commit a real .env with your LAN addresses)
# and fill in your own values. Values set in the shell always override .env.

# ---------------------------------------------------------------------------
# Cameras (choose ONE style)
# ---------------------------------------------------------------------------
# Style 1: JSON map of camera id -> stream URL. Supports any scheme
# (http:// IP camera apps, rtsp://, or a device index as a string).
# Example:
# WAMSS_CAMERAS='{"CAM_01":"http://10.0.0.5:8080/video","CAM_02":"rtsp://10.0.0.6:554/live"}'

# Style 2: simple numbered variables, one per camera. The <id> part may be
# digits or a short name, e.g. WAMSS_CAM_FRONT_URL. Keys become CAM_<id>.
# Example:
# WAMSS_CAM_01_URL=http://10.0.0.5:8080/video
# WAMSS_CAM_02_URL=http://10.0.0.6:8080/video

# If neither style is set, the pipeline falls back to SAMPLE-ONLY placeholder
# URLs (192.0.2.x documentation addresses). It will run, connect to nothing
# real, and warn loudly. This fallback is intentional: no real LAN addresses
# are baked into the code.

# ---------------------------------------------------------------------------
# Backend /event endpoint (the real backend)
# ---------------------------------------------------------------------------
# Where detection events are POSTed. Default: http://localhost:8000/event
# Example for a backend on another machine on the LAN:
# WAMSS_BACKEND_URL=http://10.0.0.20:8000/event

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Path to YOLO weights. Default: yolov8n.pt (downloads automatically on
# first run). Point this at a trained checkpoint for production.
# Example:
# WAMSS_MODEL_PATH=/opt/wamss/models/wamss_yolov8n_v3.pt

# ---------------------------------------------------------------------------
# Event throttling
# ---------------------------------------------------------------------------
# Minimum seconds between event POSTs per camera. Default: 1.0
# Example:
# WAMSS_EVENT_INTERVAL=2.0

# ---------------------------------------------------------------------------
# Headless mode
# ---------------------------------------------------------------------------
# 1/true/yes/on = skip cv2.imshow/waitKey window calls and log detection
# summaries instead. 0/false/no/off = show preview windows.
# Default: headless when no DISPLAY is set on Linux (typical for servers);
# windowed everywhere else. Override explicitly either way.
# Example:
# WAMSS_HEADLESS=1

# ---------------------------------------------------------------------------
# Face recognition (non-privacy path only; never runs in privacy mode)
# ---------------------------------------------------------------------------
# Enroll with: python vision/enroll_face.py --photo <photo.jpg> --name "Name"
# Gallery lives in vision/faces/ (never commit those files).
# WAMSS_FACE_ID=0 disables recognition (all names "unknown"). Default: 1
# Example:
# WAMSS_FACE_ID=1

# First-sighting snapshots (JPEG crops, one per new track, recognised or
# not). Empty disables snapshots. Default: data/snapshots
# Example:
# WAMSS_SNAPSHOT_DIR=data/snapshots

# Optional room calibration JSON (vision/room_calib.py). Default: empty
# Example:
# WAMSS_ROOM_CALIB=

# Match thresholds: insightface cosine similarity (default 0.5), LBPH
# distance (default 70).
# Example:
# WAMSS_FACE_SIM_THRESHOLD=0.5
# WAMSS_LBPH_THRESHOLD=70

# Identity cache: re-verify each track every 30 frames or 5 s (whichever
# comes first); keep the last 7 votes; a name needs 2 agreeing votes with
# mean confidence 0.5 to be assigned; drop a track after 600 s unseen.
# Example:
# WAMSS_IDENTITY_RECHECK_FRAMES=30
# WAMSS_IDENTITY_RECHECK_SECONDS=5.0
# WAMSS_IDENTITY_VOTE_WINDOW=7
# WAMSS_IDENTITY_MIN_VOTES=2
# WAMSS_IDENTITY_MIN_CONFIDENCE=0.5
# WAMSS_IDENTITY_STALE_SECONDS=600

# Gallery sync: a running node picks up dashboard enrollments without a
# restart by polling GET /faces/gallery/version on the backend. Sync is
# OFF unless a backend is explicitly configured: set
# WAMSS_GALLERY_BASE_URL, or set WAMSS_BACKEND_URL (the /event suffix is
# stripped). Poll every 30 s by default; 0 disables polling. Never runs
# in privacy mode. Note: enrollments made with enroll_face.py directly on
# the node still need a node restart; only dashboard enrollments (which go
# through the backend) reach a running node through this sync.
# Example:
# WAMSS_GALLERY_BASE_URL=http://192.168.1.20:8000
# WAMSS_GALLERY_POLL_SECONDS=30
