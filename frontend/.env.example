# Local-dev default: the Vite dev server (npm run dev) has no nginx proxy,
# so point it at your backend directly. Copy to .env and adjust as needed:
#   cp .env.example .env
VITE_API_URL=http://localhost:8000
# NOTE: the Docker deployment ignores this file and leaves VITE_API_URL
# empty, so the dashboard uses the same-origin /api/* proxy (which also
# attaches the API key server-side). See nginx.conf.template, docs/AUTH.md.
